generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  NOT_ACTIVE
}

enum MailerType {
  GMAIL
  DOMAIN
  MASK

  @@map("SenderType")
}

enum SmtpMailerAccountStatus {
  ACTIVE
  PAUSED
  ARCHIVED

  @@map("SenderAccountStatus")
}

enum SmtpMailerHealthStatus {
  ACTIVE
  BURNED
  BANNED
  NOT_WORKING

  @@map("SenderHealthStatus")
}

enum DeliveryStatus {
  QUEUED
  SENT
  FAILED
}

enum AutomationWorkerStatus {
  WORKING
  PAUSED
}

enum AutomationLeadStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model User {
  id           String                 @id @default(cuid())
  firstName    String
  lastName     String
  pseudoName   String
  email        String                 @unique
  passwordHash String
  role         Role
  status       UserStatus             @default(ACTIVE)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  allocations  UserMailerAllocation[]
  deliveries   DeliveryRecord[]
  sessions     UserSession[]
  templates    EmailTemplate[]
  createdAutomationWorkers AutomationWorker[] @relation("AutomationWorkerCreator")
}

model UserSession {
  id               String    @id
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?
  ipAddress        String?
  userAgent        String?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SmtpMailerAccount {
  id                   String                  @id @default(cuid())
  type                 MailerType
  label                String
  email                String
  provider             String
  status               SmtpMailerAccountStatus @default(ACTIVE)
  healthStatus         SmtpMailerHealthStatus  @default(ACTIVE)
  lastHealthCheckAt    DateTime?
  lastHealthMessage    String?
  dailyLimit           Int
  encryptionKeyHint    String?
  credentialsEncrypted String?
  metadata             Json?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  deliveries           DeliveryRecord[]

  @@unique([type, email])
  @@map("SenderAccount")
}

model MailerPolicy {
  id         String     @id @default(cuid())
  mailerType MailerType @unique @map("senderType")
  dailyLimit Int
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("SenderPolicy")
}


model MailerReplyToOption {
  id         String     @id @default(cuid())
  mailerType MailerType @map("senderType")
  label      String
  email      String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([mailerType, email])
  @@index([mailerType])
}

model MailerCooldownSetting {
  id         String     @id @default(cuid())
  mailerType MailerType @unique @map("senderType")
  schedule   Int[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}
model UserMailerAllocation {
  id            String     @id @default(cuid())
  userId        String
  mailerType    MailerType @map("senderType")
  assignedLimit Int
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mailerType])
  @@map("UserSenderAllocation")
}

model DeliveryRecord {
  id                  String             @id @default(cuid())
  deliveryId          String
  userId              String
  mailerType          MailerType         @map("senderType")
  smtpMailerAccountId String?            @map("senderAccountId")
  recipientEmail      String
  status              DeliveryStatus     @default(QUEUED)
  providerMessageId   String?
  messageIdHeader     String?
  errorMessage        String?
  sentAt              DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  smtpMailerAccount   SmtpMailerAccount? @relation(fields: [smtpMailerAccountId], references: [id], onDelete: SetNull)

  @@index([deliveryId])
  @@index([userId, mailerType, createdAt])
  @@index([smtpMailerAccountId, createdAt])
}
model EmailTemplate {
  id               String   @id @default(cuid())
  key              String   @unique
  name             String
  description      String?
  fields           Json
  supportedMailers Json     @default("[]")
  subject          String   @default("")
  contentHtml      String   @default("")
  isActive         Boolean  @default(true)
  createdById      String?
  createdBy        User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([createdById])
}
model AutomationWorker {
  id          String                             @id @default(cuid())
  name        String
  pseudoName  String
  status      AutomationWorkerStatus             @default(PAUSED)
  createdById String?
  startTime   String
  createdAt   DateTime                           @default(now())
  updatedAt   DateTime                           @updatedAt
  createdBy   User?                              @relation("AutomationWorkerCreator", fields: [createdById], references: [id], onDelete: SetNull)
  leads       AutomationLead[]
  allocations AutomationWorkerMailerAllocation[]

  @@index([status])
}

model AutomationWorkerMailerAllocation {
  id            String           @id @default(cuid())
  workerId      String
  mailerType    MailerType       @map("senderType")
  assignedLimit Int
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  worker        AutomationWorker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, mailerType])
  @@index([mailerType])
}

model AutomationLead {
  id              String               @id @default(cuid())
  workerId        String?
  templateId      String
  templateKey     String
  mailerType      MailerType           @map("senderType")
  fromName        String
  fromEmail       String?
  replyTo         String
  subject         String?
  previewText     String?
  recipientEmail  String
  clientName      String?
  templateValues  Json
  status          AutomationLeadStatus @default(PENDING)
  errorMessage    String?
  scheduledAt     DateTime
  sentAt          DateTime?
  workDate        String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  worker          AutomationWorker?    @relation(fields: [workerId], references: [id], onDelete: SetNull)

  @@index([workerId, workDate])
  @@index([status, scheduledAt])
  @@index([templateId])
}


